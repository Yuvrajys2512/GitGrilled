# Required: get your key at https://console.groq.com/keys
GROQ_API_KEY=...

# Optional: increases GitHub API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_...

# Optional: interviewer voice provider. "edge" (default) = Microsoft Edge's
# free neural TTS (no key, much more human — a calm British male by default).
# "groq" = Groq Orpheus (American, more robotic). "browser" = skip server TTS
# and use the browser's built-in voice.
# TTS_PROVIDER=edge
#
# Edge neural voice + cadence. Other good male voices: en-GB-ThomasNeural,
# en-US-GuyNeural, en-US-ChristopherNeural, en-US-EricNeural. Rate/pitch are
# SSML relative values for a calm, measured delivery.
# EDGE_TTS_VOICE=en-GB-RyanNeural
# EDGE_TTS_RATE=-6%
# EDGE_TTS_PITCH=-2st
#
# Groq Orpheus TTS settings (only used when TTS_PROVIDER=groq, or as fallback).
# Uses GROQ_API_KEY above.
# One-time: accept the model terms at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Male voices: daniel, austin, troy. Female: autumn, diana, hannah. Falls back
# to the browser's built-in voice if unset or unavailable.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=daniel
#
# Vocal direction: Orpheus reads flat/robotic with no direction. We prepend a
# bracketed tag to every line for a calmer, more human delivery. Default is
# [calm]. Try [measured], [confidently], [warm], or combos like
# "[calm, measured]" for a composed, Jarvis-like read. Set to empty to disable.
# GROQ_TTS_STYLE=[calm]
#
# Set to 1 to skip Groq TTS entirely and use the browser's built-in voice. The
# browser fallback prefers a British male voice (Google UK English Male /
# Microsoft Ryan), which is closer to a Jarvis accent but less natural than
# Orpheus. Flip this to compare the two by ear.
# GROQ_TTS_DISABLED=1

# Optional: absolute site URL for OG/share images (auto-detected on Vercel)
# NEXT_PUBLIC_SITE_URL=https://gitgrilled.example.com

# Optional: models for the structured profile/debrief generation. Must support
# Groq json_schema structured outputs (llama-3.3-70b does NOT). Default is
# llama-4-scout (fast, high token/min limit). gpt-oss-120b is higher quality but
# has a lower TPM ceiling — better for small repos.
# GROQ_PROFILE_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_DEBRIEF_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: the interview model (must support tool calling). Default
# llama-3.3-70b. Override to spread load across daily token budgets or to use a
# stronger model. Examples: openai/gpt-oss-120b, llama-3.1-8b-instant
# GROQ_INTERVIEW_MODEL=llama-3.3-70b-versatile

# Optional: Upstash Redis. Powers three things, each degrading gracefully if
# unset: (1) distributed rate limiting (falls back to in-memory), (2) caching
# generated profiles per repo+commit (instant/free repeat visits & Try Again),
# (3) short /scorecard?id= share links (falls back to long ?d= base64 links).
# Create a free Redis DB at https://console.upstash.com and copy its REST creds.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
